<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    DirectoryIndex index.html index.php

    # mod_dir would 301 /admin to /admin/ (the directory) before the clean-URL
    # rewrite below can serve admin.html. Indexes are off, so turning the
    # automatic trailing-slash redirect off is safe here.
    DirectorySlash Off

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # --- Clean URLs -------------------------------------------------------
    # Tests THE_REQUEST (the original request line) rather than the rewritten
    # path, so the internal rewrite below can never bounce back through here.

    # /index.html -> /   and   /user/index.html -> /user/
    RewriteCond %{THE_REQUEST} \s/+(.*?)index\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # /login.html -> /login
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # Serve the matching .html file for an extensionless URL.
    # No !-d guard: /admin must serve admin.html even though an admin/ directory
    # also exists, otherwise mod_dir redirects /admin to the directory instead.
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]
    # ----------------------------------------------------------------------

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>